# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432   # change if a local PostgreSQL already owns this port
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=ai_operations_agent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ── LLM ───────────────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run the agent on its deterministic path:
# the graph, the tools and the guardrails all work without a model.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Agent guardrails ──────────────────────────────────────────────────────────
MAX_TOOL_CALLS=12
MAX_WORKFLOW_STEPS=30
TOOL_TIMEOUT_SECONDS=15

# ── MCP integration layer ─────────────────────────────────────────────────────
# When false, the agent runs against in-process mock providers instead of
# connecting to the four MCP servers.
MCP_ENABLED=true

# ── Workflow persistence ──────────────────────────────────────────────────────
# Where a run paused for approval is kept. Only "postgres" survives a restart;
# "memory" is for tests and single-process demos.
CHECKPOINTER=postgres

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
