# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432   # change if a local PostgreSQL already owns this port
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=ai_operations_agent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
