# Everything the build does not need. Without this the context includes the
# local virtualenv — a couple of hundred megabytes shipped to the daemon on
# every build, for files the image rebuilds from the lockfile anyway.

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

.git/
.github/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# Tests, docs and tooling are not part of the runtime image. README.md stays:
# pyproject declares it as the project readme, so the build needs it.
tests/
docs/
tools/
deploy/
TASK.md
CLAUDE.md
AGENTS.md
.claude/

# Secrets must never reach a build context.
.env
.env.*
!.env.example

*.db
*.sqlite3
.DS_Store
